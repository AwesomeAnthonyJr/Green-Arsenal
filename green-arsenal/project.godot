; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Green Arsenal"
run/main_scene="uid://fxu24q0thxdc"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://durk43shgquph"

[autoload]

Preloads="*uid://c5n6qt55bpyrn"
SaveManager="*uid://bd8wrv5ug7xbf"
Constants="*uid://cjfdyywyi6tqs"
SoundManager="*uid://cxkyfowaxnljm"
Generics="*uid://cb4njgqi3uf2o"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"gardener": "res://misc/dialogic/gardener.dch",
"mentor": "res://misc/dialogic/mentor.dch",
"operator": "res://misc/dialogic/operator.dch"
}
directories/dtl_directory={
"final_mentor": "res://misc/dialogic/final_mentor.dtl",
"fire_seed_operator": "res://misc/dialogic/fire_seed_operator.dtl",
"fire_seed_operator2": "res://misc/dialogic/fire_seed_operator2.dtl",
"forest3_mentor": "res://misc/dialogic/forest3_mentor.dtl",
"generic_operator": "res://misc/dialogic/generic_operator.dtl",
"intro": "res://misc/dialogic/intro.dtl",
"intro2_operator": "res://misc/dialogic/intro2_operator.dtl",
"intro_operator": "res://misc/dialogic/intro_operator.dtl",
"underground_entrance_mentor": "res://misc/dialogic/underground_entrance_mentor.dtl",
"underground_operator": "res://misc/dialogic/underground_operator.dtl"
}
layout/style_directory={
"": "res://misc/dialogic/speaker_box.tres",
"VN_box": "res://misc/dialogic/VN_box.tres",
"speaker_box": "res://misc/dialogic/speaker_box.tres"
}
layout/style_list=["res://misc/dialogic/speaker_box.tres", "res://misc/dialogic/VN_box.tres"]
layout/default_style="res://misc/dialogic/speaker_box.tres"
glossary/default_case_sensitive=true
variables={}
SoundManager="*uid://cxkyfowaxnljm"
Generics="*uid://cb4njgqi3uf2o"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
audio/type_sound_bus="Sound"
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "Sound",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "Music",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[global_group]

soil="for planting seeds in"
player="for the player"
blaze_flower="for the blaze flower"
torch="for torches!"
player_package=""
fresh_water="plants can grow in this typicall"
seeker_flower="for da seeka flowa"
roller=""
propellable="for the propeller seed"
not_ground="for when a staticbody shouldnt let the player jump"
springvine_ground="for specifically the springvines weird behavior"
target="for targets"
plant="for enemies to attack"

